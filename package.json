{
  "name": "orbit-desktop",
  "productName": "Orbit Desktop",
  "version": "0.4.1",
  "description": "Windows product task manager prototype",
  "author": "Orbit Desktop",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:win": "electron-builder --win nsis zip --x64 --publish never",
    "test:target-browser": "node --test test/target.browser.cjs"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.orbitdesktop.app",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Orbit Desktop",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ]
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
